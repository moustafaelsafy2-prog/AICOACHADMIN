generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CASHIER") // "ADMIN" or "CASHIER"
  shifts    Shift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  startTime   DateTime  @default(now())
  endTime     DateTime?
  startCash   Float     @default(0)
  endCash     Float?
  status      String    @default("OPEN") // "OPEN", "CLOSED"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  price       Float
  stock       Float        @default(0)
  unit        String       @default("قطعة") // "قطعة", "جرام", "مل", etc.
  type        String       @default("STANDARD") // "STANDARD", "COMPOSITE", "INGREDIENT"
  barcode     String?      @unique
  imageUrl    String?
  categoryId  Int?
  category    Category?    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  recipeItems RecipeItem[] @relation("CompositeProduct")
  usedIn      RecipeItem[] @relation("IngredientProduct")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model RecipeItem {
  id            Int      @id @default(autoincrement())
  productId     Int      // The composite product
  product       Product  @relation("CompositeProduct", fields: [productId], references: [id], onDelete: Cascade)
  ingredientId  Int      // The raw material/ingredient
  ingredient    Product  @relation("IngredientProduct", fields: [ingredientId], references: [id])
  quantity      Float    // Amount of ingredient needed
}

model DeliveryWorker {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String?
  balance     Float     @default(0) // Money collected from cash deliveries
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  loyaltyPoints Int       @default(0)
  orders        Order[]
  balance       Float     @default(0) // For tracking debt
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id               Int             @id @default(autoincrement())
  totalAmount      Float
  items            OrderItem[]
  type             String          @default("TAKEAWAY") // "TAKEAWAY", "DELIVERY"
  deliveryFee      Float           @default(0)
  deliveryWorkerId Int?
  deliveryWorker   DeliveryWorker? @relation(fields: [deliveryWorkerId], references: [id])
  customerId       Int?
  customer         Customer?       @relation(fields: [customerId], references: [id])
  paymentType      String          @default("CASH") // "CASH", "CARD", "DEBT"
  status           String          @default("COMPLETED") // "COMPLETED", "RETURNED", "CANCELLED"
  createdAt        DateTime        @default(now())
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Settings {
  id                Int      @id @default(autoincrement())
  companyName       String   @default("نظام نقاط البيع")
  companyLogo       String?
  companyAddress    String?
  companyPhone      String?
  currency          String   @default("ر.س")
  taxRate           Float    @default(15.0)
  receiptFooterText String?  @default("شكراً لتسوقكم معنا")
  updatedAt         DateTime @updatedAt
}