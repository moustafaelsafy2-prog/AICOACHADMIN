generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CASHIER") // "ADMIN" or "CASHIER"
  shifts    Shift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  startTime   DateTime  @default(now())
  endTime     DateTime?
  startCash   Float     @default(0)
  endCash     Float?
  status      String    @default("OPEN") // "OPEN", "CLOSED"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  stock       Int         @default(0)
  barcode     String?     @unique
  imageUrl    String?
  categoryId  Int?
  category    Category?   @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Customer {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  orders      Order[]
  balance     Float     @default(0) // For tracking debt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id          Int         @id @default(autoincrement())
  totalAmount Float
  items       OrderItem[]
  customerId  Int?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  paymentType String      @default("CASH") // "CASH", "CARD", "DEBT"
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Settings {
  id                Int      @id @default(autoincrement())
  companyName       String   @default("نظام نقاط البيع")
  companyLogo       String?
  companyAddress    String?
  companyPhone      String?
  currency          String   @default("ر.س")
  taxRate           Float    @default(15.0)
  receiptFooterText String?  @default("شكراً لتسوقكم معنا")
  updatedAt         DateTime @updatedAt
}